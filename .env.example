# --- Database ---
# 本地開發：DATABASE_URL 與 DIRECT_URL 可指向同一個 Postgres。
# Vercel/serverless：DATABASE_URL 用 pooled 連線（pooler），DIRECT_URL 用 direct 連線（供 prisma migrate deploy）。
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/bus_route_trainer"
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/bus_route_trainer"
# 只給 Vercel Preview。必須是「不是 production」的 direct URL。
# 本地與 production 不要設。同時把 Preview 的 DATABASE_URL 指到同一顆庫。見 DEPLOY.md。
# PREVIEW_DIRECT_URL="postgresql://USER:PASSWORD@preview-host:5432/bus_route_trainer"

# --- Auth ---
# 簽章 session cookie 的密鑰。production 必設為強隨機值（未設會導致啟動時報錯）。
# 產生方式：openssl rand -base64 32
AUTH_SECRET="change-me-to-a-strong-random-value"

# 對外網址（重設密碼信的連結用這個，不用 request 的 Host header，防 password reset poisoning）。
# production 必設，例如 https://your-app.vercel.app（未設時不寄重設信）。本地可不設（改用 request origin）。
# APP_URL="https://your-app.example.com"

# --- Trusted upstream gateway（預設關閉，Vercel 部署不要開）---
# 只有在 app 前面有「會剝除客戶端送來的 x-authenticated-driver-id、再自己加上」的反向代理時才開。
# 開啟時必須同時設 UPSTREAM_AUTH_SECRET（>= 32 字元），且代理要在每個請求帶 x-upstream-auth-secret；
# 缺密鑰或不符一律 401。
# TRUST_UPSTREAM_DRIVER_HEADER="true"
# UPSTREAM_AUTH_SECRET="$(openssl rand -base64 32)"
