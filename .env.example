# --- Database ---
# 本地開發：DATABASE_URL 與 DIRECT_URL 可指向同一個 Postgres。
# Vercel/serverless：DATABASE_URL 用 pooled 連線（pooler），DIRECT_URL 用 direct 連線（供 prisma migrate deploy）。
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/bus_route_trainer"
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/bus_route_trainer"

# --- Auth ---
# 簽章 session cookie 的密鑰。production 必設為強隨機值（未設會導致啟動時報錯）。
# 產生方式：openssl rand -base64 32
AUTH_SECRET="change-me-to-a-strong-random-value"
